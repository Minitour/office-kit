# Icons are Lucide via @iconify-json/lucide. Use <lucide-name class="ok-icon" />.
# Layout vocabulary below: keep, reorder, duplicate, or delete slides as needed.
# Never invent a layout name — use only names from slidev-layouts / deck.py audit.
layout: cover
class: ok-cover
